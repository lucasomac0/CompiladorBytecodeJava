double maior (double a, double b)
{
  int m;
  
  if (a > b) {m = a;}
  else {m = b;}
  return m;
}

int fat (int n)
{
  int f;
  
  f = 1;
  while (n > 0 && n < 10)
  { 
    f = f * n;
    n = n - 1;
  }
  return f;
}

